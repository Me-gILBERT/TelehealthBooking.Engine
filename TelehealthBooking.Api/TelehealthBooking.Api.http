@TelehealthBooking.Api_HostAddress = http://localhost:5279

### Book a new appointment
POST {{TelehealthBooking.Api_HostAddress}}/api/appointments
Content-Type: application/json

{
  "patientId": "00000000-0000-0000-0000-000000000001",
  "doctorId": "00000000-0000-0000-0000-000000000002",
  "scheduledTimeUtc": "2026-06-15T14:00:00Z"
}

### Try booking an overlapping appointment (should fail with 400)
POST {{TelehealthBooking.Api_HostAddress}}/api/appointments
Content-Type: application/json

{
  "patientId": "00000000-0000-0000-0000-000000000003",
  "doctorId": "00000000-0000-0000-0000-000000000002",
  "scheduledTimeUtc": "2026-06-15T14:15:00Z"
}

### Try booking with invalid data (past date — should fail validation)
POST {{TelehealthBooking.Api_HostAddress}}/api/appointments
Content-Type: application/json

{
  "patientId": "00000000-0000-0000-0000-000000000001",
  "doctorId": "00000000-0000-0000-0000-000000000002",
  "scheduledTimeUtc": "2020-01-01T00:00:00Z"
}
